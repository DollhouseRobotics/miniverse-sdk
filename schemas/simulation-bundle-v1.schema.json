{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dollhouserobotics.com/schemas/simulation-bundle-v1.schema.json",
  "title": "Dollhouse Simulation Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "primarySimulator", "embodiment", "models", "program"],
  "properties": {
    "version": {"const": "v1"},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "minLength": 1, "maxLength": 600},
    "primarySimulator": {"$ref": "#/$defs/simulator"},
    "compatibleSimulators": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/simulator"}
    },
    "environment": {
      "description": "Omit for builtin flat ground. A GLB heightfield or MJCF environment names its bundle-relative source entrypoint.",
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "path"],
          "properties": {
            "kind": {"const": "glb"},
            "path": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^environment/(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\).+\\.glb$"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "path"],
          "properties": {
            "kind": {"const": "mjcf"},
            "path": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^environment/(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\).+\\.(?:xml|mjcf)$"}
          }
        }
      ]
    },
    "embodiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"const": "mjcf"},
        "path": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^embodiment/(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\).+\\.(?:xml|mjcf)$"},
        "appearance": {"$ref": "#/$defs/appearance"},
        "bodyDynamicsOverrides": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["bodyGroup", "bodyIds", "set"],
            "properties": {
              "bodyGroup": {"$ref": "#/$defs/id"},
              "bodyIds": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
              "set": {
                "type": "object", "additionalProperties": false, "minProperties": 1,
                "properties": {
                  "linearDamping": {"type": "number", "minimum": 0},
                  "angularDamping": {"type": "number", "minimum": 0},
                  "maximumLinearVelocity": {"type": "number", "exclusiveMinimum": 0},
                  "maximumAngularVelocity": {"type": "number", "exclusiveMinimum": 0}
                }
              }
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {"id": {"$ref": "#/$defs/id"}}
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "entrypoint"],
      "properties": {
        "apiVersion": {"const": "dhr.python-policy/v1"},
        "entrypoint": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 200}
      }
    },
    "commands": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/command"}},
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "properties": {
        "components": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "renderer", "commandId"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "renderer": {"type": "string", "pattern": "^(builtin|custom)/", "not": {"const": "builtin/heading"}, "maxLength": 160},
              "commandId": {"$ref": "#/$defs/id"},
              "options": {"type": "object"}
            },
            "allOf": [
              {
                "if": {"properties": {"renderer": {"const": "builtin/gamepad"}}, "required": ["renderer"]},
                "then": {
                  "required": ["options"],
                  "properties": {"options": {"$ref": "#/$defs/gamepadOptions"}}
                }
              }
            ]
          }
        }
      }
    },
    "gizmos": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "frame"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["target", "arrow", "point", "frame", "path", "sphere", "box"]},
          "frame": {"type": "string", "minLength": 1, "maxLength": 80},
          "color": {"type": "string", "minLength": 1, "maxLength": 32},
          "label": {"type": "string", "minLength": 1, "maxLength": 160},
          "scale": {"type": "number", "minimum": 0.1, "maximum": 4}
        },
        "allOf": [{
          "if": {"required": ["scale"]},
          "then": {"properties": {"kind": {"const": "arrow"}}}
        }]
      }
    },
    "webModules": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["command-ui", "gizmo-overlay"]},
          "source": {"type": "string", "minLength": 1, "maxLength": 65536}
        }
      }
    },
    "viewer": {
      "description": "Optional presentation preferences. Omit this field to use Miniverse's stock viewer settings.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["framingScale"],
          "properties": {
            "framingScale": {
              "description": "Multiplier for automatic camera framing. Values above 1 show more of the scene; 1 preserves the stock framing.",
              "type": "number",
              "minimum": 0.5,
              "maximum": 3
            }
          }
        },
        "worldBend": {
          "description": "Presentation-only world bending preference. World bending is enabled when this object is omitted.",
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"}
          }
        }
      }
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "simulator": {"enum": ["mujoco", "browser-mujoco", "isaac-sim-cpu-physx", "isaac-sim-gpu-physx"]},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "gamepadOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindings"],
      "properties": {
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/gamepadBinding"}
        }
      }
    },
    "gamepadBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "input"],
      "properties": {
        "component": {"type": "integer", "minimum": 0, "default": 0},
        "source": {"enum": ["axis", "button", "magnitude", "angle"]},
        "input": {"type": "string"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "invert": {"type": "boolean", "default": false},
        "deadzone": {"type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0.15},
        "toggle": {"type": "boolean", "default": false}
      },
      "allOf": [
        {"if": {"properties": {"source": {"const": "axis"}}, "required": ["source"]}, "then": {"properties": {"input": {"enum": ["left-stick-x", "left-stick-y", "right-stick-x", "right-stick-y"]}}}},
        {"if": {"properties": {"source": {"const": "button"}}, "required": ["source"]}, "then": {"properties": {"input": {"enum": ["south", "east", "west", "north", "left-bumper", "right-bumper", "left-trigger", "right-trigger", "select", "start", "left-stick-press", "right-stick-press", "dpad-up", "dpad-down", "dpad-left", "dpad-right", "home"]}}}},
        {"if": {"properties": {"source": {"enum": ["magnitude", "angle"]}}, "required": ["source"]}, "then": {"properties": {"input": {"enum": ["left-stick", "right-stick"]}}}}
      ]
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geometry": {"description": "auto and mjcf use authored geometry; inertial is an explicit debug-only visualization", "enum": ["auto", "mjcf", "inertial"]},
        "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "edge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "widthPx": {"type": "number", "minimum": 0.25, "maximum": 8},
            "creaseAngleDegrees": {"type": "number", "minimum": 0, "maximum": 180}
          }
        }
      }
    },
    "command": {
      "type": "object",
      "required": ["id", "kind", "default", "step", "frame", "sliceLength", "update"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["joystick2d", "scalar", "targetPosition", "boolean", "momentary"]},
        "default": {},
        "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "frame": {"type": "string", "minLength": 1, "maxLength": 80},
        "sliceLength": {"type": "integer", "minimum": 1, "maximum": 64},
        "update": {"enum": ["continuous", "on-release", "edge"]},
        "restart": {"const": "episode"},
        "floorPicking": {"type": "boolean"},
        "gizmoId": {"$ref": "#/$defs/id"},
        "spatialLimit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "anchor", "maxDistance"],
          "properties": {
            "kind": {"const": "planarRadius"},
            "anchor": {"const": "rootBody"},
            "maxDistance": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"not": {"const": "targetPosition"}}}},
          "then": {"required": ["range"]}
        },
        {
          "if": {"required": ["restart"]},
          "then": {"properties": {"update": {"enum": ["on-release", "edge"]}}}
        },
        {
          "if": {"required": ["spatialLimit"]},
          "then": {
            "properties": {
              "kind": {"const": "targetPosition"},
              "frame": {"const": "world"},
              "sliceLength": {"const": 3}
            },
            "not": {"required": ["range"]}
          }
        }
      ]
    }
  }
}
